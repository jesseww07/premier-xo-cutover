<workflow scriptid="customworkflow_rma_status_notification">
  <description></description>
  <initcontexts>ACTION|BANKCONNECTIVITY|BANKSTATEMENTPARSER|BUNDLEINSTALLATION|CLIENT|CSVIMPORT|CUSTOMGLLINES|CUSTOMMASSUPDATE|RECORDACTION|CUSTOMTOOL|DATASETBUILDER|DEBUGGER|EMAILCAPTURE|FICONNECTIVITY|FIPARSER|MAPREDUCE|OCRPLUGIN|OFFLINECLIENT|OTHER|PAYMENTPOSTBACK|PAYMENTGATEWAY|PLATFORMEXTENSION|PORTLET|PROMOTIONS|CONSOLRATEADJUSTOR|RESTWEBSERVICES|RESTLET|ADVANCEDREVREC|SCHEDULED|SDFINSTALLATION|SHIPPINGPARTNERS|WEBSERVICES|SUITELET|TAXCALCULATION|USEREVENT|USERINTERFACE|WORKBOOKBUILDER|WORKFLOW</initcontexts>
  <initeventtypes></initeventtypes>
  <initlocalizationcontext></initlocalizationcontext>
  <initoncreate>T</initoncreate>
  <initonvieworupdate>T</initonvieworupdate>
  <initsavedsearchcondition></initsavedsearchcondition>
  <inittriggertype>AFTERSUBMIT</inittriggertype>
  <isinactive>F</isinactive>
  <islogenabled>T</islogenabled>
  <keephistory>ALWAYS</keephistory>
  <name>RMA Status Notification</name>
  <recordtypes>RETURNAUTHORIZATION</recordtypes>
  <releasestatus>RELEASED</releasestatus>
  <runasadmin>F</runasadmin>
  <initcondition>
    <formula><![CDATA["Status" IN ("Transaction Status1","Transaction Status2","Transaction Status3")]]></formula>
    <type>VISUAL_BUILDER</type>
    <parameters>
      <parameter>
        <name>Status</name>
        <value>STDBODYSTATUS</value>
      </parameter>
      <parameter>
        <name>Transaction Status1</name>
        <selectrecordtype>-164</selectrecordtype>
        <value>40</value>
      </parameter>
      <parameter>
        <name>Transaction Status2</name>
        <selectrecordtype>-164</selectrecordtype>
        <value>39</value>
      </parameter>
      <parameter>
        <name>Transaction Status3</name>
        <selectrecordtype>-164</selectrecordtype>
        <value>42</value>
      </parameter>
    </parameters>
  </initcondition>
  <workflowstates>
    <workflowstate scriptid="workflowstate365">
      <description></description>
      <donotexitworkflow>F</donotexitworkflow>
      <name>Monitoring/Notify</name>
      <positionx>243</positionx>
      <positiony>133</positiony>
      <workflowactions triggertype="ONENTRY">
        <sendemailaction scriptid="workflowaction1792">
          <attachmentfield></attachmentfield>
          <attachmentfile></attachmentfile>
          <attachmentjoinfield></attachmentjoinfield>
          <attachmenttype>SPECIFIC</attachmenttype>
          <body>&lt;p&gt;{tranid}, {entity}, {status}&lt;/p&gt;</body>
          <conditionsavedsearch></conditionsavedsearch>
          <contexttypes>ACTION|BANKCONNECTIVITY|BANKSTATEMENTPARSER|BUNDLEINSTALLATION|CLIENT|CSVIMPORT|CUSTOMGLLINES|CUSTOMMASSUPDATE|RECORDACTION|CUSTOMTOOL|DATASETBUILDER|DEBUGGER|EMAILCAPTURE|FICONNECTIVITY|FIPARSER|MAPREDUCE|OCRPLUGIN|OFFLINECLIENT|OTHER|PAYMENTPOSTBACK|PAYMENTGATEWAY|PLATFORMEXTENSION|PORTLET|PROMOTIONS|CONSOLRATEADJUSTOR|RESTWEBSERVICES|RESTLET|ADVANCEDREVREC|SCHEDULED|SDFINSTALLATION|SHIPPINGPARTNERS|WEBSERVICES|SUITELET|TAXCALCULATION|USEREVENT|USERINTERFACE|WORKBOOKBUILDER|WORKFLOW</contexttypes>
          <eventtypes></eventtypes>
          <includeformat>PDF</includeformat>
          <includerecordlink>T</includerecordlink>
          <includetransaction>T</includetransaction>
          <isinactive>F</isinactive>
          <recipient>[ACCOUNT_SPECIFIC_VALUE]</recipient>
          <recipientbccemail>jessew@shoppremier.com</recipientbccemail>
          <recipientccemail>SHAWN@SHOPPREMIER.COM</recipientccemail>
          <recipientemail></recipientemail>
          <recipientfield></recipientfield>
          <recipientjoinfield></recipientjoinfield>
          <recipienttype>SPECIFIC</recipienttype>
          <scheduledelay></scheduledelay>
          <schedulemode>DELAY</schedulemode>
          <schedulerecurrence></schedulerecurrence>
          <scheduletimeofday></scheduletimeofday>
          <scheduletimeunit></scheduletimeunit>
          <sender>[ACCOUNT_SPECIFIC_VALUE]</sender>
          <senderfield></senderfield>
          <senderjoinfield></senderjoinfield>
          <sendertype>SPECIFIC</sendertype>
          <subject>RMA {tranid} - Removed from Open RMA Report</subject>
          <template></template>
          <usetemplate>F</usetemplate>
          <initcondition>
            <formula></formula>
            <type>VISUAL_BUILDER</type>
          </initcondition>
        </sendemailaction>
      </workflowactions>
    </workflowstate>
  </workflowstates>
</workflow>