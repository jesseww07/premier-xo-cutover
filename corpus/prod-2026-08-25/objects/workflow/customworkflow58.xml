<workflow scriptid="customworkflow58">
  <description>Mirror Item Name &amp; Vendor Name</description>
  <initcontexts></initcontexts>
  <initeventtypes>CREATE|EDIT</initeventtypes>
  <initlocalizationcontext></initlocalizationcontext>
  <initoncreate>T</initoncreate>
  <initonvieworupdate>T</initonvieworupdate>
  <initsavedsearchcondition></initsavedsearchcondition>
  <inittriggertype>BEFORESUBMIT</inittriggertype>
  <isinactive>T</isinactive>
  <islogenabled>F</islogenabled>
  <keephistory>ALWAYS</keephistory>
  <name>Mirror Item Name &amp; Vendor Name</name>
  <recordtypes>INVENTORYITEM</recordtypes>
  <releasestatus>RELEASED</releasestatus>
  <runasadmin>T</runasadmin>
  <initcondition>
    <formula><![CDATA["Type" IN ("Item Type1") AND isChecked("Inactive") = 'F' AND "Vendor Name" != "Name"]]></formula>
    <type>VISUAL_BUILDER</type>
    <parameters>
      <parameter>
        <name>Type</name>
        <value>STDITEMITEMTYPE</value>
      </parameter>
      <parameter>
        <name>Item Type1</name>
        <selectrecordtype>-106</selectrecordtype>
        <value>1</value>
      </parameter>
      <parameter>
        <name>Inactive</name>
        <value>STDITEMISINACTIVE</value>
      </parameter>
      <parameter>
        <name>Vendor Name</name>
        <value>STDITEMVENDORNAME</value>
      </parameter>
      <parameter>
        <name>Name</name>
        <value>STDITEMNAME</value>
      </parameter>
    </parameters>
  </initcondition>
  <workflowstates>
    <workflowstate scriptid="workflowstate344">
      <description></description>
      <donotexitworkflow>F</donotexitworkflow>
      <name>State 1</name>
      <positionx>303</positionx>
      <positiony>143</positiony>
      <workflowactions triggertype="BEFORESUBMIT">
        <setfieldvalueaction scriptid="workflowaction1767">
          <clienttriggerfields></clienttriggerfields>
          <conditionsavedsearch></conditionsavedsearch>
          <contexttypes>ACTION|BANKCONNECTIVITY|BANKSTATEMENTPARSER|BUNDLEINSTALLATION|CLIENT|CSVIMPORT|CUSTOMGLLINES|CUSTOMMASSUPDATE|RECORDACTION|DATASETBUILDER|DEBUGGER|EMAILCAPTURE|FICONNECTIVITY|FIPARSER|MAPREDUCE|OCRPLUGIN|OFFLINECLIENT|OTHER|PAYMENTPOSTBACK|PAYMENTGATEWAY|PLATFORMEXTENSION|PORTLET|PROMOTIONS|CONSOLRATEADJUSTOR|RESTWEBSERVICES|RESTLET|ADVANCEDREVREC|SCHEDULED|SDFINSTALLATION|SHIPPINGPARTNERS|WEBSERVICES|SUITELET|TAXCALCULATION|USEREVENT|USERINTERFACE|WORKBOOKBUILDER|WORKFLOW</contexttypes>
          <eventtypes>CREATE|EDIT</eventtypes>
          <field>STDITEMVENDORNAME</field>
          <isinactive>F</isinactive>
          <scheduledelay></scheduledelay>
          <schedulemode>DELAY</schedulemode>
          <schedulerecurrence></schedulerecurrence>
          <scheduletimeofday></scheduletimeofday>
          <scheduletimeunit></scheduletimeunit>
          <valuechecked>F</valuechecked>
          <valuedate></valuedate>
          <valuefield>STDITEMNAME</valuefield>
          <valueformula></valueformula>
          <valuejoinfield></valuejoinfield>
          <valueselect></valueselect>
          <valuetext></valuetext>
          <valuetype>FIELD</valuetype>
          <initcondition>
            <formula><![CDATA[isEmpty("Vendor Name") = 'T']]></formula>
            <type>VISUAL_BUILDER</type>
            <parameters>
              <parameter>
                <name>Vendor Name</name>
                <value>STDITEMVENDORNAME</value>
              </parameter>
            </parameters>
          </initcondition>
        </setfieldvalueaction>
      </workflowactions>
    </workflowstate>
  </workflowstates>
</workflow>