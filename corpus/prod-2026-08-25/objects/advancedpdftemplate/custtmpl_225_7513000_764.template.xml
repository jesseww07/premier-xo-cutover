<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
	<link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}" src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}" src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
	<#if .locale == "zh_CN">
		<link name="NotoSansCJKsc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKsc_Regular}" src-bold="${nsfont.NotoSansCJKsc_Bold}" bytes="2" />
	<#elseif .locale == "zh_TW">
		<link name="NotoSansCJKtc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKtc_Regular}" src-bold="${nsfont.NotoSansCJKtc_Bold}" bytes="2" />
	<#elseif .locale == "ja_JP">
		<link name="NotoSansCJKjp" type="font" subtype="opentype" src="${nsfont.NotoSansCJKjp_Regular}" src-bold="${nsfont.NotoSansCJKjp_Bold}" bytes="2" />
	<#elseif .locale == "ko_KR">
		<link name="NotoSansCJKkr" type="font" subtype="opentype" src="${nsfont.NotoSansCJKkr_Regular}" src-bold="${nsfont.NotoSansCJKkr_Bold}" bytes="2" />
	<#elseif .locale == "th_TH">
		<link name="NotoSansThai" type="font" subtype="opentype" src="${nsfont.NotoSansThai_Regular}" src-bold="${nsfont.NotoSansThai_Bold}" bytes="2" />
	</#if>
    <macrolist>
        <macro id="nlheader">
            
<table class="header" style="width: 100%; border-collapse: collapse; height: 126.925px; border-width: 0px; border-color: rgb(255, 255, 255);" border="1"><tr style="height: 63.4625px;">
<td style="height: 126.925px; padding: 5px; border-color: rgb(255, 255, 255);" rowspan="3"><#if companyInformation.logoUrl?length != 0> <@filecabinet nstype="image" style="float: left; margin: 3px;" src="${companyInformation.logoUrl}" width="175" height="117" /> </#if></td>
<td style="height: 63.4625px; padding: 5px; border-color: rgb(255, 255, 255);" align="right"><span class="title">${record@title}</span></td>
</tr>
<tr style="height: 44.8px;">
<td style="height: 44.8px; padding: 5px; border-color: rgb(255, 255, 255);" align="right"><span class="number">#<span style="font-size: 24pt;">${record.tranid}</span></span></td>
</tr>
<tr style="height: 18.6625px;">
<td style="height: 18.6625px; padding: 5px; border-color: rgb(255, 255, 255);" align="right">&nbsp;</td>
</tr></table>

        </macro>
        <macro id="nlfooter">
            
<table class="footer" style="width: 100%;"><tr>
<td colspan="2"><barcode codetype="code128" showtext="true" value="${record.tranid}"/></td>
<td class="address" colspan="8" rowspan="2" align="center">Premier Lighting, LLC<br />4024 E Broadway Rd, Ste 1001, Phoenix, Arizona 85040<br />Ph (866) 907-2669 contact@shoppremier.com<br />https://shoppremier.com</td>
<#assign aDateTime = .now> <#assign aDate = aDateTime?date> <#assign aTime = aDateTime?time>
<td colspan="2" align="right"><pagenumber/> of <totalpages/><br />${aDateTime?string.short}</td>
</tr></table>
<table class="footer" style="width: 100%;"><tr>
<td><barcode codetype="code128" showtext="true" value="${record.tranid}"/></td>
<td align="right"><pagenumber/> of <totalpages/></td>
</tr></table>

        </macro>
    </macrolist>
    <style type="text/css">* {
        <#if .locale == "zh_CN">
            font-family: NotoSans, NotoSansCJKsc, sans-serif;
        <#elseif .locale == "zh_TW">
            font-family: NotoSans, NotoSansCJKtc, sans-serif;
        <#elseif .locale == "ja_JP">
            font-family: NotoSans, NotoSansCJKjp, sans-serif;
        <#elseif .locale == "ko_KR">
            font-family: NotoSans, NotoSansCJKkr, sans-serif;
        <#elseif .locale == "th_TH">
            font-family: NotoSans, NotoSansThai, sans-serif;
        <#else>
            font-family: NotoSans, sans-serif;
        </#if>
        }
        table {
            font-size: 9pt;
            table-layout: fixed;
        }
        th {
            font-weight: bold;
            font-size: 9pt;
            vertical-align: middle;
            padding: 5px 6px 3px;
            background-color: #e3e3e3;
            color: #333333;
        }
        td {
            padding: 4px 6px;
        }
        td p { align:left }
        b {
            font-weight: bold;
            color: #333333;
        }
        table.header td {
            padding: 0;
            font-size: 10pt;
        }
        table.footer td {
            padding: 0;
            font-size: 8pt;
        }
        table.itemtable th {
            padding-bottom: 10px;
            padding-top: 10px;
        }
        table.body td {
            padding-top: 2px;
        }
        table.total {
            page-break-inside: avoid;
        }
        tr.totalrow {
            background-color: #e3e3e3;
            line-height: 200%;
        }
        td.totalboxtop {
            font-size: 12pt;
            background-color: #e3e3e3;
        }
        td.addressheader {
            font-size: 8pt;
            padding-top: 6px;
            padding-bottom: 2px;
        }
        td.address {
            padding-top: 0;
        }
        td.totalboxmid {
            font-size: 28pt;
            padding-top: 10px;
            background-color: #e3e3e3;
        }
        td.totalboxbot {
            background-color: #e3e3e3;
            font-weight: bold;
        }
        span.title {
            font-size: 34pt;
        }
        span.number {
            font-size: 16pt;
        }
        span.itemname {
            font-weight: bold;
            line-height: 150%;
        }
        hr {
            width: 100%;
            color: #d3d3d3;
            background-color: #d3d3d3;
            height: 1px;
        }
</style>
</head>
<body header="nlheader" header-height="10%" footer="nlfooter" footer-height="30pt" padding="0.5in" size="Letter">
    <table style="width: 100%; border-collapse: collapse; height: 232.125px;" border="0"><tr style="height: 14.925px;">
<td class="addressheader" style="padding: 15px; height: 14.925px;" colspan="5">&nbsp;</td>
<td class="addressheader" style="padding: 15px; height: 14.925px;" colspan="5">&nbsp;</td>
<td class="addressheader" style="padding: 15px; height: 14.925px;" colspan="5">&nbsp;</td>
</tr>
<tr style="height: 217.2px;">
<td class="address" style="padding: 15px; height: 217.2px;" colspan="5" rowspan="3">
<p><strong>${record.billaddress@label}</strong></p>
<p>${record.billaddress}</p>
</td>
<td class="address" style="padding: 15px; height: 217.2px;" colspan="5" rowspan="3">
<p><strong>${record.shipaddress@label}</strong></p>
<p>${record.shipaddress}<#if record.shipphone?has_content><#else><br />${record.entity.phone}</#if></p>
</td>
<td class="address" style="padding: 15px; height: 217.2px;" colspan="6" rowspan="1" align="left"><strong>Invoice Date: </strong>${record.trandate}<br /><strong>Due Date: </strong>${record.duedate}<br /><strong>Sales Rep: </strong>${record.salesrep}<br /><strong>SO #: </strong>${record.createdfrom}<br /><strong>Terms: </strong>${record.terms}<br /><strong>Sidemark: </strong>${record.custbody_pr_sidemark}<br /><strong>Customer PO#: </strong>${record.entity.custentity_customer_po}<br /><#if record.entity = 'ROBSON COMMUNITIES'> <strong>LT No: </strong>${record. custbody_pr_robson_lt}<br /><strong>Job No: </strong>${record. custbody_pr_robson_job}<br /><strong>Release No: </strong>${record. custbody_pr_robson_release}<br /><strong>Account No: </strong>${record. custbody_pr_robson_account}<br /><strong>Sequence No: </strong>${record. custbody_pr_robson_seq} </#if></td>
</tr></table>
<hr /><#if record.item?has_content>
<table class="itemtable" style="width: 100%; border-collapse: collapse;" border="0"><!-- start items --><#list record.item as item><#if item_index==0><#assign row=0>
<thead>
<tr>
<th style="padding: 15px;" colspan="8">Item</th>
<th style="padding: 15px;" colspan="7" align="left">${item.custcol_pr_room_location@label}</th>
<th style="padding: 15px;" colspan="6" align="left">${item.quantity@label}</th>
<#if record.custbody_pr_include_bin = true>
<th style="padding: 15px;" colspan="5" align="right">${item.inventorydetail@label}</th>
</#if>
<th style="padding: 15px;" colspan="4" align="left">${item.rate@label}</th>
<th style="padding: 15px;" colspan="4" align="left">Tax</th>
<th style="padding: 15px;" colspan="4" align="left">Amount</th>
</tr>
</thead>
</#if> <#if item.item != 'Subtotal'><tr style="background-color: &lt;!--mce:protected %3c%23if%20%28row%20%25%202%29%20%3d%3d%200%3e--&gt;white&lt;!--mce:protected %3c%23else%3e--&gt;#ededed&lt;!--mce:protected %3c/%23if%3e--&gt;;"><#if !record.custbody_pl_print_product_code>
<td style="padding: 15px;" colspan="8"><span class="itemname">${item.custcol_pl_item_name}</span><br />${item.description}</td>
<#else>
<td style="padding: 15px;" colspan="8"><span class="itemname">${item.item.displayname}</span><br />${item.description}</td>
</#if>
<td style="padding: 15px;" colspan="7" align="left">${item.custcol_pr_room_location}</td>
<td style="padding: 15px;" colspan="3" align="center">${item.quantity}</td>
<#if record.custbody_pr_include_bin = true>
<td style="padding: 15px;" colspan="5" align="left"><#list item.inventorydetail?split("<br />") as seq> <#if seq?index &lt; 16> <#list seq?split("(") as bin> <#if bin?index &lt; 1>${bin}<br /></#if> </#list> </#if> </#list></td>
</#if>
<td style="padding: 15px;" colspan="4" align="right">${item.rate?string.currency}</td>
<td style="padding: 15px;" colspan="3" align="right">${record.shippingtax1rate}</td>
<td style="padding: 15px;" colspan="4" align="right">${item.amount}</td>
<#assign row = row + 1></tr>
</#if> </#list><!-- end items --></table>
</#if><hr />
<table style="break-inside: avoid; width: 100%; margin-top: 10px; border-collapse: collapse; margin-left: auto; margin-right: auto; height: 189.6px;" border="1"><tr style="height: 16.8px;">
<td style="height: 16.8px; width: 59.1667%;" colspan="4">&nbsp;</td>
<td style="font-weight: bold; color: rgb(51, 51, 51); height: 16.8px; width: 23.0591%;" align="right">${record.subtotal@label}</td>
<td style="height: 16.8px; width: 17.787%;" align="right">${record.subtotal}</td>
</tr>
<tr style="height: 16.8px;">
<td style="height: 16.8px; width: 59.1667%;" colspan="4">&nbsp;</td>
<td style="font-weight: bold; color: rgb(51, 51, 51); height: 16.8px; width: 23.0591%;" align="right">${record.discounttotal@label}</td>
<td style="height: 16.8px; width: 17.787%;" align="right">${record.discounttotal}</td>
</tr>
<tr style="height: 16.8px;">
<td style="height: 16.8px; width: 59.1667%;" colspan="4">&nbsp;</td>
<td style="height: 16.8px; width: 23.0591%;" align="right"><strong>${record.taxtotal@label} (${record.taxgrouprate})</strong></td>
<td style="height: 16.8px; width: 17.787%;" align="right">${record.taxtotal}</td>
</tr>
<tr style="height: 16.8px;">
<td style="height: 16.8px; width: 59.1667%;" colspan="4">&nbsp;</td>
<td style="font-weight: bold; color: rgb(51, 51, 51); height: 16.8px; width: 23.0591%;" align="right">${record.shippingcost@label}</td>
<td style="height: 16.8px; width: 17.787%;" align="right">${record.shippingcost}</td>
</tr>
<tr style="background-color: rgb(227, 227, 227); line-height: 200%; height: 24px;">
<td style="height: 24px; width: 59.1667%;" colspan="4">&nbsp;</td>
<td style="font-weight: bold; color: rgb(51, 51, 51); height: 24px; width: 23.0591%;" align="right">${record.total@label}</td>
<td style="height: 24px; width: 17.787%;" align="right">${record.total}</td>
</tr>
<tr style="background-color: rgb(227, 227, 227); line-height: 200%; height: 24px;">
<td style="height: 24px; width: 59.1667%;" colspan="4">&nbsp;</td>
<td style="font-weight: bold; color: rgb(51, 51, 51); height: 24px; width: 23.0591%;" align="right">${record.amountpaid@label}</td>
<td style="height: 24px; width: 17.787%;" align="right">${record.amountpaid}</td>
</tr>
<tr style="background-color: rgb(227, 227, 227); line-height: 200%; height: 24px;">
<td style="height: 24px; width: 59.1667%;" colspan="4">&nbsp;</td>
<td style="font-weight: bold; color: rgb(51, 51, 51); height: 24px; width: 23.0591%;" align="right">${record.amountremaining@label}</td>
<td style="height: 24px; width: 17.787%;" align="right">${record.amountremaining}</td>
</tr></table>
&nbsp;
<table style="width: 100%;"><tr>
<td><strong>RETURN POLICY</strong> Installed items are NOT refundable. All returns must have original packaging. Upon receipt of package, it is your responsibility to thoroughly inspect the merchandise within. If there is any damage or missing parts, you have 5 days from receiving date to contact Premier Lighting. Failure to do so could result in the denial of a possible claim. Stock orders may be returned within 15 days of purchase. Items must be un-installed (no wires or chain cut) and in original packaging. Displays can be returned within 15 days in original sold condition. Invoices marked FINAL SALE are non-refundable. Special Orders from PL Partners can be returned within 15 days with no penalty, all other vendors will incur a 25% restock fee for return within 15 days. Special orders are non-returnable/non-refundable 15 days from delivery. Full payment is due at time of Special Order. A $15 handling fee will be assessed for any special order under $100. PL is not liable for delayed shipments &amp; any costs incurred by those delays. INSTALLS must be paid in full prior being scheduled. Store Credits Expire in 1 year from the invoice date. Product Damaged/Missing parts must be reported to PL within 7 days. See a Sales Person for further details.</td>
</tr></table>
</body>
</pdf>