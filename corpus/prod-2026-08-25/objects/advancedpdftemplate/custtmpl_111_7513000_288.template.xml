<?xml version="1.0"?><!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
	<link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}" src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}" src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
	<#if .locale == "zh_CN">
		<link name="NotoSansCJKsc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKsc_Regular}" src-bold="${nsfont.NotoSansCJKsc_Bold}" bytes="2" />
	<#elseif .locale == "zh_TW">
		<link name="NotoSansCJKtc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKtc_Regular}" src-bold="${nsfont.NotoSansCJKtc_Bold}" bytes="2" />
	<#elseif .locale == "ja_JP">
		<link name="NotoSansCJKjp" type="font" subtype="opentype" src="${nsfont.NotoSansCJKjp_Regular}" src-bold="${nsfont.NotoSansCJKjp_Bold}" bytes="2" />
	<#elseif .locale == "ko_KR">
		<link name="NotoSansCJKkr" type="font" subtype="opentype" src="${nsfont.NotoSansCJKkr_Regular}" src-bold="${nsfont.NotoSansCJKkr_Bold}" bytes="2" />
	<#elseif .locale == "th_TH">
		<link name="NotoSansThai" type="font" subtype="opentype" src="${nsfont.NotoSansThai_Regular}" src-bold="${nsfont.NotoSansThai_Bold}" bytes="2" />
	</#if>
    <macrolist>
        <macro id="nlheader">
            
<table style="width: 100%; font-size: 10pt;"><tr>
<td style="padding-top: -25px; padding-left: -10px;" rowspan="1"><#if companyInformation.logoUrl?length != 0><@filecabinet nstype="image" style="float: left; margin: 1px; width: 242px; height: 117px;" src="${companyInformation.logoUrl}" /> </#if></td>
<td style="padding-top: 0px;" align="right">
<p style="text-align: right;"><span style="font-size: 16pt;">${record.tranid}</span></p>
</td>
<!-- <td align="right" style="padding-top: 0px;"><span style="font-size: 24pt;">${record.tranid}</span></td>  --></tr></table>

        </macro>
        <macro id="nlfooter">
            --&gt;
<table class="footer" style="width: 100%;"><tr>
<td colspan="2"><barcode codetype="code128" showtext="true" value="${record.tranid}"/></td>
<#if record.location = 'Phoenix : PHX-DC'>
<td class="address" colspan="8" rowspan="2" align="center">Premier Lighting<br />4024 E Broadway Rd Suite 1001 Phoenix AZ 85040<br />Ph: (866) 907-2669 contact@shoppremier.com<br />https://shoppremier.com</td>
<#elseif record.location = 'Tucson : TUC-WH'>
<td class="address" colspan="8" rowspan="2" align="center">Northside Warehouse<br />630 E. Ft. Lowell Road Tucson, AZ 85705<br />Ph: (866) 907-2669 contact@shoppremier.com<br />https://shoppremier.com</td>
<#else>
<td class="address" colspan="8" rowspan="2" align="center">
<p align="center">Premier Lighting<br />4024 E Broadway Rd Suite 1001 Phoenix AZ 85040<br />Ph: (866) 907-2669 contact@shoppremier.com<br />https://shoppremier.com</p>
</td>
</#if><#assign aDateTime = .now><#assign aDate = aDateTime?date><#assign aTime = aDateTime?time>
<td colspan="2" align="right"><pagenumber/> of <totalpages/><br />${aDateTime?string.short}</td>
</tr></table>

        </macro>
    </macrolist>
    <style type="text/css">* {
		<#if .locale == "zh_CN">
			font-family: NotoSans, NotoSansCJKsc, sans-serif;
		<#elseif .locale == "zh_TW">
			font-family: NotoSans, NotoSansCJKtc, sans-serif;
		<#elseif .locale == "ja_JP">
			font-family: NotoSans, NotoSansCJKjp, sans-serif;
		<#elseif .locale == "ko_KR">
			font-family: NotoSans, NotoSansCJKkr, sans-serif;
		<#elseif .locale == "th_TH">
			font-family: NotoSans, NotoSansThai, sans-serif;
		<#else>
			font-family: NotoSans, sans-serif;
		</#if>
		}
		table {
			font-size: 9pt;
			table-layout: fixed;
		}
        th {
            font-weight: bold;
            font-size: 8pt;
            vertical-align: middle;
            padding: 5px 6px 3px;
            background-color: #e3e3e3;
            color: #333333;
        }
        td {
            padding: 4px 6px;
        }
		td p { align:left }
        b {
            font-weight: bold;
            color: #333333;
        }
        table.header td {
            padding: 0;
            font-size: 10pt;
        }
        table.footer td {
            padding: 0;
            font-size: 8pt;
        }
        table.itemtable th {
            padding-bottom: 10px;
            padding-top: 10px;
        }
        table.body td {
            padding-top: 2px;
        }
        table.total {
            page-break-inside: avoid;
        }
        tr.totalrow {
            background-color: #e3e3e3;
            line-height: 200%;
        }
        td.totalboxtop {
            font-size: 12pt;
            background-color: #e3e3e3;
        }
        td.addressheader {
            font-size: 8pt;
            padding-top: 6px;
            padding-bottom: 2px;
        }
        td.address {
            padding-top: 0;
        }
        td.totalboxmid {
            font-size: 28pt;
            padding-top: 20px;
            background-color: #e3e3e3;
        }
        td.totalboxbot {
            background-color: #e3e3e3;
            font-weight: bold;
        }
        span.title {
            font-size: 28pt;
        }
        span.number {
            font-size: 16pt;
        }
        span.itemname {
            font-weight: bold;
            line-height: 150%;
        }
        hr {
            width: 100%;
            color: #d3d3d3;
            background-color: #d3d3d3;
            height: 1px;
        }
</style>
</head>
<body header="nlheader" header-height="8%" footer="nlfooter" footer-height="20pt" padding="0.5in 0.5in 0.5in 0.5in" size="Letter">
    <table style="width: 100%;"><tr>
<td class="addressheader" colspan="5"><strong>${record.billaddress@label}</strong></td>
<td class="addressheader" colspan="8"><strong>${record.shipaddress@label}</strong></td>
<td class="addressheader" colspan="6">&nbsp;</td>
</tr>
<tr>
<td class="address" colspan="5" rowspan="2">${record.billaddress}</td>
<td class="address" colspan="8" rowspan="2">${record.shipaddress}<#if record.shipphone?has_content><#else><br />${record.entity.phone}</#if></td>
<td class="address" colspan="6" rowspan="2" align="left"><strong>Due Date: </strong>${record.duedate}<br /><strong>PO #: </strong>${record.otherrefnum}<br /><strong>Ship Date: </strong>${record.shipdate}<br /><strong>Ship Method: </strong>${record.shipmethod}<br /><strong>Sidemark: </strong>${record.custbody_pr_sidemark}<br /><strong>Sales Rep: </strong>${record.salesrep}</td>
</tr></table>
<hr /><#if record.item?has_content>
<table class="itemtable" style="width: 100%;"><!-- start items --><#list record.item as item><#if item_index==0><#assign row=0>
<thead>
<tr>
<th colspan="8" align="left">Item</th>
<th colspan="8" align="left">${item.custcol_pr_room_location@label}</th>
<th colspan="3" align="center">${item.quantity@label}</th>
<#if !record.custbody_pr_suppress_unit_cost>
<th colspan="4" align="right">${item.rate@label}</th>
</#if>
<th colspan="4" align="right">Amount</th>
</tr>
</thead>
</#if><tr style="background-color: &lt;!--mce:protected %3c%23if%20%28row%20%25%202%29%20%3d%3d%200%3e--&gt;white&lt;!--mce:protected %3c%23else%3e--&gt;#ededed&lt;!--mce:protected %3c/%23if%3e--&gt;;"><#if !record.custbody_pl_print_product_code>
<td colspan="8"><span class="itemname">${item.custcol_pl_item_name}</span><br />${item.description}</td>
<#else>
<td colspan="8"><span class="itemname">${item.olditemid}</span><br />${item.description}</td>
</#if>
<td colspan="8" align="left">${item.custcol_pr_room_location}</td>
<td colspan="3" align="center">${item.quantity}</td>
<#if !record.custbody_pr_suppress_unit_cost>
<td colspan="4" align="right">${item.rate?string.currency}</td>
</#if>
<td colspan="4" align="right">${item.amount}</td>
<#assign row = row + 1></tr>
</#list><!-- end items --></table>
</#if><#if record.expense?has_content>
<table class="itemtable" style="width: 100%;"><!-- start expenses --><#list record.expense as expense ><#if expense_index==0>
<thead>
<tr>
<th colspan="12">${expense.category@label}</th>
<th colspan="10">${expense.account@label}</th>
<th colspan="4" align="right">${expense.amount@label}</th>
</tr>
</thead>
</#if><tr>
<td colspan="12">${expense.category}</td>
<td colspan="10"><span class="itemname">${expense.account}</span></td>
<td colspan="4" align="right">${expense.amount}</td>
</tr>
</#list><!-- end expenses --></table>
</#if><hr />
<table style="page-break-inside: avoid; width: 100%; margin-top: 10px;"><tr>
<td colspan="3">&nbsp;</td>
<td style="font-weight: bold; color: #333333;" align="right">${record.subtotal@label}</td>
<td align="right">${record.subtotal}</td>
</tr>
<tr>
<td colspan="3">&nbsp;</td>
<td style="font-weight: bold; color: #333333;" align="right">${record.taxtotal@label}</td>
<td align="right">${record.taxtotal}</td>
</tr>
<tr>
<td colspan="3">&nbsp;</td>
<td style="font-weight: bold; color: #333333;" align="right">Shipping &amp; Handling</td>
<td align="right">${record.shippingcost}</td>
</tr>
<#if record.discounttotal lt 0>
<tr style="line-height: 200%;">
<td colspan="3">&nbsp;</td>
<td style="font-weight: bold; color: #333333;" align="right">Discount</td>
<td align="right">${record.discounttotal}</td>
</tr>
</#if>
<tr style="background-color: #e3e3e3; line-height: 200%;">
<td colspan="3">&nbsp;</td>
<td style="font-weight: bold; color: #333333;" align="right">${record.total@label}</td>
<td align="right">${record.total}</td>
</tr></table>
</body>
</pdf>