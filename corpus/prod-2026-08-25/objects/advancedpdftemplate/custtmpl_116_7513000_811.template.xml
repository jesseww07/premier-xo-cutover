<?xml version="1.0"?><!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
	<link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}" src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}" src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
	<#if .locale == "zh_CN">
		<link name="NotoSansCJKsc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKsc_Regular}" src-bold="${nsfont.NotoSansCJKsc_Bold}" bytes="2" />
	<#elseif .locale == "zh_TW">
		<link name="NotoSansCJKtc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKtc_Regular}" src-bold="${nsfont.NotoSansCJKtc_Bold}" bytes="2" />
	<#elseif .locale == "ja_JP">
		<link name="NotoSansCJKjp" type="font" subtype="opentype" src="${nsfont.NotoSansCJKjp_Regular}" src-bold="${nsfont.NotoSansCJKjp_Bold}" bytes="2" />
	<#elseif .locale == "ko_KR">
		<link name="NotoSansCJKkr" type="font" subtype="opentype" src="${nsfont.NotoSansCJKkr_Regular}" src-bold="${nsfont.NotoSansCJKkr_Bold}" bytes="2" />
	<#elseif .locale == "th_TH">
		<link name="NotoSansThai" type="font" subtype="opentype" src="${nsfont.NotoSansThai_Regular}" src-bold="${nsfont.NotoSansThai_Bold}" bytes="2" />
	</#if>
    <macrolist>
        <macro id="nlheader">
            <table style="width: 100%; font-size: 10pt;"><tr>
	<td rowspan="1" style="padding-top: -25px; padding-left: -10px;"><#if companyInformation.logoUrl?length != 0><img src="${companyInformation.logoUrl}" style="float: left; margin: 1px; width: 209px; height: 101px" /> </#if></td>
	<td align="right" style="padding-top: 0px;"><span style="font-size: 20pt;">${record.tranid}</span></td>
	<!-- <td align="right" style="padding-top: 0px;"><span style="font-size: 24pt;">${record.tranid}</span></td>  --></tr></table>
        </macro>
        <macro id="nlfooter">
            --&gt;
<table class="footer" style="width: 100%;"><tr>
	<td><barcode codetype="code128" showtext="true" value="${record.tranid}"/></td>
	<#if record.location = 'PHX-DC'>

      <td align="center" class="address" colspan="8" rowspan="2">
	<p align="center" text-align="center">Premier Lighting<br />4024 East Broadway Road, Suite 1001 Phoenix, AZ 85040<br />Ph: 623-907-2669 contact@shoppremier.com<br />https://shoppremier.com</p>
	</td>
	<#elseif record.location = 'TUC-WH'>
      <td align="center" class="address" colspan="8" rowspan="2">
	<p align="center" text-align="center">Northside Warehouse<br />630 E. Ft. Lowell Road Tucson, AZ 85705<br />Ph: 520-293-6111 contact@shoppremier.com<br />https://shoppremier.com</p>
	</td>
	<#else>
	<td align="center" class="address" colspan="8" rowspan="2">
	<p align="center" text-align="center">Premier Lighting<br />15507 N. Scotttsdale Rd., Suite 140 Scottsdale, AZ 85254<br />Ph: (480) 699-3534 contact@shoppremier.com<br />https://shoppremier.com</p>
	</td>
	</#if>
	<td align="right"><pagenumber/> of <totalpages/></td>
	</tr></table>
        </macro>
    </macrolist>
    <style type="text/css">* {
		<#if .locale == "zh_CN">
			font-family: NotoSans, NotoSansCJKsc, sans-serif;
		<#elseif .locale == "zh_TW">
			font-family: NotoSans, NotoSansCJKtc, sans-serif;
		<#elseif .locale == "ja_JP">
			font-family: NotoSans, NotoSansCJKjp, sans-serif;
		<#elseif .locale == "ko_KR">
			font-family: NotoSans, NotoSansCJKkr, sans-serif;
		<#elseif .locale == "th_TH">
			font-family: NotoSans, NotoSansThai, sans-serif;
		<#else>
			font-family: NotoSans, sans-serif;
		</#if>
		}
		table {
			font-size: 9pt;
			table-layout: fixed;
		}
        th {
            font-weight: bold;
            font-size: 8pt;
            vertical-align: middle;
            padding: 5px 6px 3px;
            background-color: #e3e3e3;
            color: #333333;
        }
        td {
            padding: 4px 6px;
        }
		td p { align:left }
        b {
            font-weight: bold;
            color: #333333;
        }
        table.header td {
            padding: 0;
            font-size: 10pt;
        }
        table.footer td {
            padding: 0;
            font-size: 8pt;
        }
        table.itemtable th {
            padding-bottom: 10px;
            padding-top: 10px;
        }
        table.body td {
            padding-top: 2px;
        }
        table.total {
            page-break-inside: avoid;
        }
        tr.totalrow {
            background-color: #e3e3e3;
            line-height: 200%;
        }
        td.totalboxtop {
            font-size: 12pt;
            background-color: #e3e3e3;
        }
        td.addressheader {
            font-size: 8pt;
            padding-top: 6px;
            padding-bottom: 2px;
        }
        td.address {
            padding-top: 0;
        }
        td.totalboxmid {
            font-size: 28pt;
            padding-top: 20px;
            background-color: #e3e3e3;
        }
        td.totalboxbot {
            background-color: #e3e3e3;
            font-weight: bold;
        }
        span.title {
            font-size: 28pt;
        }
        span.number {
            font-size: 16pt;
        }
        span.itemname {
            font-weight: bold;
            line-height: 150%;
        }
        hr {
            width: 100%;
            color: #d3d3d3;
            background-color: #d3d3d3;
            height: 1px;
        }
</style>
</head>
<body header="nlheader" header-height="7%" footer="nlfooter" footer-height="20pt" padding="0.5in 0.5in 0.5in 0.5in" size="Letter">
    <table style="width: 100%;"><tr>
	<td class="addressheader" colspan="5"><b>${record.billaddress@label}</b></td>
	<td class="addressheader" colspan="8"><b>${record.shipaddress@label}</b></td>
	<td class="addressheader" colspan="6">&nbsp;</td>
	</tr>
	<tr>
	<td class="address" colspan="5" rowspan="2">${record.billaddress}</td>
	<td class="address" colspan="8" rowspan="2">${record.shipaddress}</td>
	<td align="left" class="address" colspan="6" rowspan="2"><b>Due Date: </b>${record.duedate}<br /><b>Document #: </b>${record.tranid}<br /><b>PO #: </b>${record.otherrefnum}<br /><b>Sidemark: </b>${record.custbody_pr_sidemark}<br /><b>Sales Rep: </b>${record.salesrep}</td>
	</tr></table>

<hr /><#if record.item?has_content>
<table class="itemtable" style="width: 100%;"><!-- start items --><#list record.item as item><#if item_index==0><#assign row=0>
<thead>
	<tr>
	<th align="left" colspan="8">Item</th>
	<th align="center" colspan="3">${item.quantity@label}</th>
	<#if !record.custbody_pr_suppress_unit_cost>
	<th align="right" colspan="4">${item.rate@label}</th>
	</#if>
	<th align="right" colspan="4">Amount</th>
	</tr>
</thead>
</#if><#if item.item == 'Customer Deposit'><tr style="background-color: <#if (row % 2) == 0>white<#else>#ededed</#if>">
	<td align="left" colspan="8"><b>${item.item}</b><br />${item.description}</td>
	<td align="center" colspan="3" line-height="150%">${item.quantity}</td>
	<#if !record.custbody_pr_suppress_unit_cost>
	<td align="right" colspan="4">${item.rate}</td>
	</#if>
	<td align="right" colspan="4">${item.amount}</td>
	<#assign row = row + 1></tr>
	</#if></#list><!-- end items --></table>

<table class="itemtable" style="width: 100%;"><!-- start items --><#list record.item as item><#if item_index==0><#assign row=0>
<thead>
	<tr>
	<th align="left" colspan="5" style="line-height: 80%; font-size:7px;">MARK</th>
	<th align="center" colspan="3" style="line-height: 80%; font-size:7px;">QTY</th>
	<#if !record.custbody_pr_suppress_unit_cost>
	<th align="center" colspan="4" style="line-height: 80%; font-size:7px;">MAN</th>
	</#if>
	<th align="right" colspan="8" style="line-height: 80%; font-size:7px;">CATALOG #</th>
	</tr>
</thead>
</#if><#if item.item == 'Deposit Receipt Placeholder'><tr style="background-color: <#if (row % 2) == 0>white<#else>#ededed</#if>">
	<td align="left" colspan="5" style="line-height: 80%; font-size:7px;">${item.custcol_pr_room_location}</td>
	<td align="center" colspan="3" line-height="80%" style="line-height: 80%; font-size:7px;">${item.quantity}</td>
	<#if !record.custbody_pr_suppress_unit_cost>
	<td align="center" colspan="4" style="line-height: 80%; font-size:7px;">${item.custcol_pr_man}</td>
	</#if>
	<td align="right" colspan="8" style="line-height: 80%; font-size:7px;">${item.description}</td>
	<#assign row = row + 1></tr>
	</#if></#list><!-- end items --></table>
</#if>

<hr />
<table style="page-break-inside: avoid; width: 100%; margin-top: 10px;"><tr>
	<td colspan="3">&nbsp;</td>
	<td align="right" style="font-weight: bold; color: #333333;">${record.subtotal@label}</td>
	<td align="right">${record.subtotal}</td>
	</tr>
	<tr>
	<td colspan="3">&nbsp;</td>
	<td align="right" style="font-weight: bold; color: #333333;">${record.taxtotal@label}</td>
	<td align="right">${record.taxtotal}</td>
	</tr>
	<tr>
	<td colspan="3">&nbsp;</td>
	<td align="right" style="font-weight: bold; color: #333333;">Shipping &amp; Handling</td>
	<td align="right">${record.shippingcost}</td>
	</tr>
	<#if record.discounttotal lt 0>
	<tr style="line-height: 200%;">
	<td background-color="#ffffff" colspan="3">&nbsp;</td>
	<td align="right" style="font-weight: bold; color: #333333;">Discount</td>
	<td align="right">${record.discounttotal}</td>
	</tr>
	</#if>
	<tr style="background-color: #e3e3e3; line-height: 200%;">
	<td background-color="#ffffff" colspan="3">&nbsp;</td>
	<td align="right" style="font-weight: bold; color: #333333;">${record.total@label}</td>
	<td align="right">${record.total}</td>
	</tr></table>
</body>
</pdf>