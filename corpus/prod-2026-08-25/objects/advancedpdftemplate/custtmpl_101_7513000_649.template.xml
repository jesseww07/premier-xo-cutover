<?xml version="1.0"?><!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
	<link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}" src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}" src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
	<#if .locale == "zh_CN">
		<link name="NotoSansCJKsc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKsc_Regular}" src-bold="${nsfont.NotoSansCJKsc_Bold}" bytes="2" />
	<#elseif .locale == "zh_TW">
		<link name="NotoSansCJKtc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKtc_Regular}" src-bold="${nsfont.NotoSansCJKtc_Bold}" bytes="2" />
	<#elseif .locale == "ja_JP">
		<link name="NotoSansCJKjp" type="font" subtype="opentype" src="${nsfont.NotoSansCJKjp_Regular}" src-bold="${nsfont.NotoSansCJKjp_Bold}" bytes="2" />
	<#elseif .locale == "ko_KR">
		<link name="NotoSansCJKkr" type="font" subtype="opentype" src="${nsfont.NotoSansCJKkr_Regular}" src-bold="${nsfont.NotoSansCJKkr_Bold}" bytes="2" />
	<#elseif .locale == "th_TH">
		<link name="NotoSansThai" type="font" subtype="opentype" src="${nsfont.NotoSansThai_Regular}" src-bold="${nsfont.NotoSansThai_Bold}" bytes="2" />
	</#if>
    <macrolist>
         <macro id="nlheader">
            <table style="width: 100%; font-size: 10pt;"><tr>
	<td rowspan="1" style="padding-top: -25px; padding-left: -10px;"><#if companyInformation.logoUrl?length != 0><img src="${companyInformation.logoUrl}" style="float: left; margin: 1px; width: 209px; height: 101px" /> </#if></td>
	<td align="right" style="padding-top: 0px;"><span style="font-size: 30pt;">Picking Ticket <br/></span></td>
    <!-- <td align="right" style="padding-top: 0px;"><span style="font-size: 24pt;">${record.tranid}</span></td>  -->       
	</tr></table>
        </macro>
        <macro id="nlfooter">
            <table class="footer" style="width: 100%;"><tr>
	<td><barcode codetype="code128" showtext="true" value="${record.tranid}"/></td>
	<#assign aDateTime = .now>
<#assign aDate = aDateTime?date>
<#assign aTime = aDateTime?time>
	<td colspan="2" align="right"><pagenumber/> of <totalpages/><br/>
         ${aDateTime?string.short} </td>
	</tr></table>
        </macro>
    </macrolist>
    <style type="text/css">* {
		<#if .locale == "zh_CN">
			font-family: NotoSans, NotoSansCJKsc, sans-serif;
		<#elseif .locale == "zh_TW">
			font-family: NotoSans, NotoSansCJKtc, sans-serif;
		<#elseif .locale == "ja_JP">
			font-family: NotoSans, NotoSansCJKjp, sans-serif;
		<#elseif .locale == "ko_KR">
			font-family: NotoSans, NotoSansCJKkr, sans-serif;
		<#elseif .locale == "th_TH">
			font-family: NotoSans, NotoSansThai, sans-serif;
		<#else>
			font-family: NotoSans, sans-serif;
		</#if>
		}
		table {
			font-size: 9pt;
			table-layout: fixed;
		}
        th {
            font-weight: bold;
            font-size: 8pt;
            vertical-align: middle;
            padding: 5px 6px 3px;
            background-color: #e3e3e3;
            color: #333333;
        }
        td {
            padding: 4px 6px;
        }
		td p { align:left }
        b {
            font-weight: bold;
            color: #333333;
        }
        table.header td {
            padding: 0;
            font-size: 10pt;
        }
        table.footer td {
            padding: 0;
            font-size: 8pt;
        }
        table.itemtable th {
            padding-bottom: 10px;
            padding-top: 10px;
        }
        table.body td {
            padding-top: 2px;
        }
        table.total {
            page-break-inside: avoid;
        }
        tr.totalrow {
            background-color: #e3e3e3;
            line-height: 200%;
        }
        td.totalboxtop {
            font-size: 12pt;
            background-color: #e3e3e3;
        }
        td.addressheader {
            font-size: 8pt;
            padding-top: 6px;
            padding-bottom: 2px;
        }
        td.address {
            padding-top: 0;
        }
        td.totalboxmid {
            font-size: 28pt;
            padding-top: 20px;
            background-color: #e3e3e3;
        }
        td.totalboxbot {
            background-color: #e3e3e3;
            font-weight: bold;
        }
        span.title {
            font-size: 28pt;
        }
        span.number {
            font-size: 16pt;
        }
        span.itemname {
            font-weight: bold;
            line-height: 150%;
        }
        hr {
            width: 100%;
            color: #d3d3d3;
            background-color: #d3d3d3;
            height: 1px;
        }
</style>
</head>
      
<body header="nlheader" header-height="8%" footer="nlfooter" footer-height="20pt" padding="0.5in 0.5in 0.5in 0.5in" size="Letter">
    <table style="width: 100%;">
      <tr>
<#if record.shipaddress?has_content>
  	<td class="addressheader" colspan="5"><b>Shipping Address</b></td>
  <#else>
    	<td class="addressheader" colspan="5"><b></b></td>
  </#if>
   <#if record.createdfrom.billaddress?has_content>
  	<td class="addressheader" colspan="5"><b>Billing Address</b></td>
  <#else>
    	<td class="addressheader" colspan="5"><b></b></td>
  </#if> 
            	<td class="addressheader" colspan="6"><b></b></td>

	</tr>
	<tr>
      <#if record.createdfrom.shipaddressee?has_content>
  	<td class="address" colspan="5" rowspan="2">${record.shipaddress}</td>
  <#else>
    	<td class="address" colspan="5" rowspan="2">${record.entity}<br/>${record.shipaddress}<br/>${record.entity.altphone}</td>
  </#if> 

	<!-- <td class="address" colspan="5" rowspan="2">${record.shipaddress}<br/>${record.entity.phone}</td> -->
        
        <#if record.createdfrom.billaddress?has_content>
             
        <td class="address" colspan="5" rowspan="2">${record.createdfrom.billaddress}</td>
  </#if> 

           <!--       
<#if record.createdfrom.location = 'Phoenix : PHX-DC'>
              <td class="address" colspan="6" rowspan="2">Premier Lighting<br/>2050 South 16th Street, Suite 111<br/>Receiving Hours: 7:00am-3:00pm M-F<br/>Phoenix, AZ 85034<br/>Ph: 623-907-2669</td>
        <#elseif record.createdfrom.location = 'Tucson : TUC-WH'>
                <td class="address" colspan="6" rowspan="2">Northside Warehouse<br/>630 E. Ft. Lowell Road<br/>Receiving Hours: 9:30am-3:00pm M-F<br/>Tucson, AZ 85705<br/>Ph: 520-293-6111</td>
          <#else>
                  <td class="address" colspan="6" rowspan="2">${record.shipaddress}</td>  

        </#if>
 -->         
          	</tr>

                    
	</table>
        
  <div style="font-size: 10pt;" align="right">
    <b>Memo:</b><br/>
                      ${record.memo}
                    
        </div>      

<table class="body" style="width: 100%; margin-top: 10px;"><tr>
	<th>Delivery Date</th>
	
	<th>${record.shipmethod@label}</th>
	<!-- <th>${record.shipphone@label}</th> -->
  <th>Sidemark</th>
	</tr>
	<tr>
	<td>${record.trandate}</td>
	
	<td>${record.shipmethod}</td>
	<!-- <td>${record.shipphone}</td> -->
      <td>${record.createdfrom.custbody_pr_sidemark}</td>
	</tr></table>
<#if record.item?has_content>

<table class="itemtable" style="width: 100%; margin-top: 10px;">
<thead>
	<tr>
	<th colspan="8">${record.item[0].item@label}</th>
	<th colspan="6">Room Location</th>
	<th align="left" colspan="4">Bin</th>
	
	<th align="right" colspan="2">Quantity</th>
      <th align="right" colspan="3">Initials</th>
	</tr>
</thead>
<#list record.item as tranline><tr>
	<td colspan="8"><span class="itemname">${tranline.item}<br />${tranline.internalid}</span><br />${tranline.description}</td>
	<td colspan="6">${tranline.custcol_pr_room_location}</td>
	<td align="left" colspan="4">
  
  <#list tranline.inventorydetail?split("<br />") as seq>
    <#if seq?index &lt; 16>
        <#list seq?split("(") as bin>
           <#if bin?index &lt; 1>
            ${bin}<br/>
             </#if>
        </#list>
    </#if>
</#list>
      
  </td>
  
	<td align="right" colspan="2">${tranline.quantity}</td>
  <td style="border: 1px solid black; align: right;" colspan="1"></td>
  <td style="border: 1px solid black; align: right;" colspan="1"></td>
  <td style="border: 1px solid black; align: right;" colspan="1"></td>
	</tr>
	</#list></table>
</#if>
        
        <p>
  The items which I have initialed above have been delivered to me without visible damage.
    </p>
    <p align="right">
      Signature __________________________
    </p>
    </body>
</pdf>