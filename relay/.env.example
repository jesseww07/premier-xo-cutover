# Copy to relay/.env (git-ignored). Never commit real values.

# ---- XO Product API (the only leg with an IP constraint) ------------------------------
XO_DATABASE_NAME=            # client database name -> https://<name>.xologic.com  (Client Services)
XO_ACCESS_TOKEN=             # bearer token, does not expire; bound to the whitelisted IPv4
XO_ITEM_URL_BASE=            # domain to prepend to the relative `Item URL` path (open item)
XO_RATE_LIMIT_RPS=10         # XO ceiling is 20 fast / 1 slow; the client also backs off after slow calls
XO_SERVER_ERROR_WAIT_S=300   # XO: retry a 500 after 5 minutes
XO_SERVER_ERROR_RETRIES=1    # then alert

# ---- NetSuite: OAuth 2.0 client credentials (M2M, certificate). No IP requirement. --------
NS_ACCOUNT=7513000-SB1       # sandbox first; production = 7513000 and needs RELAY_ALLOW_PROD_WRITES=1
NS_CLIENT_ID=                # integration record client id
NS_CERT_ID=                  # certificate id from Setup > Integration > OAuth 2.0 Client Credentials Setup
NS_PRIVATE_KEY_PATH=         # PEM private key matching the uploaded public certificate
NS_PRIVATE_KEY_PASSPHRASE=

# ---- Shopify Admin (compare-at price lookup only; Matrixify still does the import) --------
SHOPIFY_STORE_DOMAIN=        # e.g. shoppremier.myshopify.com
SHOPIFY_ADMIN_TOKEN=         # read_products is enough
SHOPIFY_API_VERSION=2026-07

# ---- Relay behaviour -------------------------------------------------------------------
RELAY_WRITE_MODE=csv         # csv (Phase 1) | rest (Phase 2)
RELAY_DRY_RUN=1
RELAY_ALLOW_PROD_WRITES=0
RELAY_OUT_DIR=out
